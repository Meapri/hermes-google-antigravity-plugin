+        )
+    except ImportError as exc:
+        raise AuthError(
+            f"agent.google_antigravity_oauth is not importable: {exc}",
+            provider="google-antigravity",
+            code="antigravity_oauth_module_missing",
+        ) from exc
+
+    try:
+        access_token = get_valid_access_token(force_refresh=force_refresh)
+    except GoogleOAuthError as exc:
+        raise AuthError(
+            str(exc).replace("google-gemini-cli", "google-antigravity"),
+            provider="google-antigravity",
+            code=exc.code.replace("google_oauth", "antigravity_oauth"),
+        ) from exc
+
+    creds = load_credentials()
