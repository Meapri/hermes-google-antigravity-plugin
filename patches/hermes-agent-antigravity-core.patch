@@ -0,0 +1,133 @@
+from types import SimpleNamespace
+
+from agent.chat_completion_helpers import interruptible_streaming_api_call
+
+
+class _FakeCompletions:
+    def __init__(self, chunks):
+        self._chunks = chunks
+
+    def create(self, **kwargs):
+        self.kwargs = kwargs
+        return iter(self._chunks)
+
+
+class _FakeClient:
+    def __init__(self, chunks):
+        self.chat = SimpleNamespace(completions=_FakeCompletions(chunks))
+
+
+class _FakeAgent:
+    api_mode = "chat_completions"
+    provider = "google-antigravity"
+    model = "gemini-3.5-flash-high"
+    base_url = "https://example.invalid"
+    reasoning_callback = None
+    stream_delta_callback = None
+    verbose_logging = False
+
+    def __init__(self, chunks):
+        self._chunks = chunks
+        self._interrupt_requested = False
+        self.streamed = []
+        self.reasoning = []
+        self.tools_started = []
+        self.recorded_stream_text = []
+        self.closed_clients = []
+
+    def _create_request_openai_client(self, **kwargs):
+        return _FakeClient(self._chunks)
+
+    def _close_request_openai_client(self, client, reason):
+        self.closed_clients.append(reason)
+
+    def _touch_activity(self, message):
+        pass
+
+    def _stream_diag_init(self):
+        return {"chunks": 0, "first_chunk_at": None, "bytes": 0}
+
+    def _stream_diag_capture_response(self, diag, response):
+        pass
+
+    def _capture_rate_limits(self, response):
+        pass
+
+    def _check_openrouter_cache_status(self, response):
+        pass
+
+    def _has_stream_consumers(self):
+        return True
+
+    def _fire_stream_delta(self, text):
+        self.streamed.append(text)
+
+    def _record_streamed_assistant_text(self, text):
+        self.recorded_stream_text.append(text)
+
+    def _fire_reasoning_delta(self, text):
+        self.reasoning.append(text)
+
+    def _fire_tool_gen_started(self, name):
+        self.tools_started.append(name)
+
+    def _try_refresh_anthropic_client_credentials(self):
+        pass
+
+    def _is_provider_stream_parse_error(self, exc):
+        return False
+
+
+def _chunk(delta, finish_reason=None, model="gemini-3.5-flash-high"):
+    return SimpleNamespace(
+        model=model,
+        choices=[SimpleNamespace(delta=delta, finish_reason=finish_reason)],
+        usage=None,
+    )
+
+
+def _text_delta(text):
+    return SimpleNamespace(content=text, tool_calls=None, reasoning_content=None, reasoning=None)
+
+
+def _tool_delta(name="read_file", arguments='{"path":"/tmp/example"}'):
+    return SimpleNamespace(
+        content=None,
+        reasoning_content=None,
+        reasoning=None,
+        tool_calls=[
+            SimpleNamespace(
+                index=0,
+                id="call_1",
+                function=SimpleNamespace(name=name, arguments=arguments),
+            )
+        ],
+    )
+
+
+def test_streaming_tool_call_turn_does_not_persist_preamble_content():
+    agent = _FakeAgent([
+        _chunk(_text_delta("잠깐, 현재 구현된 내용들을 살펴보면:")),
+        _chunk(_tool_delta(), finish_reason="tool_calls"),
+    ])
+
+    response = interruptible_streaming_api_call(agent, {"messages": []})
+    assert response is not None
+
+    message = response.choices[0].message
+    assert message.tool_calls
+    assert message.content is None
+    assert message.tool_calls[0].function.name == "read_file"
+
+
+def test_streaming_plain_text_turn_still_persists_content():
+    agent = _FakeAgent([
+        _chunk(_text_delta("정상 답변입니다."), finish_reason="stop"),
+    ])
+
+    response = interruptible_streaming_api_call(agent, {"messages": []})
+    assert response is not None
+
+    message = response.choices[0].message
+    assert message.tool_calls is None
+    assert message.content == "정상 답변입니다."
