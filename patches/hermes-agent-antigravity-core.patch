+import json
+
+from tools.clarify_tool import CLARIFY_SCHEMA
+from tools.registry import registry
+
+
+def test_clarify_schema_uses_choices_not_options():
+    params = CLARIFY_SCHEMA["parameters"]
+
+    assert "choices" in params["properties"]
+    assert "options" not in params["properties"]
+    assert params["required"] == ["question"]
+    assert "Do not use an `options`" in CLARIFY_SCHEMA["description"]
+
+
+def test_clarify_handler_accepts_legacy_options_alias():
+    captured = {}
+
+    def callback(question, choices):
+        captured["question"] = question
+        captured["choices"] = choices
+        return "B"
+
+    result = registry.dispatch(
+        "clarify",
+        {"question": "Pick one", "options": ["A", "B"]},
+        callback=callback,
+    )
+
+    payload = json.loads(result)
+    assert payload["user_response"] == "B"
+    assert payload["choices_offered"] == ["A", "B"]
+    assert captured == {"question": "Pick one", "choices": ["A", "B"]}
