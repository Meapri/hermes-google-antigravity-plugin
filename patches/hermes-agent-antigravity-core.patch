+from unittest.mock import Mock
+
+
+class _InputSeq:
+    def __init__(self, values):
+        self._values = list(values)
+
+    def __call__(self, _prompt=""):
+        if not self._values:
+            raise AssertionError("unexpected input prompt")
+        return self._values.pop(0)
+
+
+def _patch_antigravity_flow(monkeypatch, *, logged_in=True):
+    import hermes_cli.auth as auth_mod
+
+    status = {
+        "logged_in": logged_in,
+        "email": "user@example.com" if logged_in else "",
+        "project_id": "test-project" if logged_in else "",
+    }
+    monkeypatch.setattr(auth_mod, "get_antigravity_auth_status", lambda: status)
+    monkeypatch.setattr(
+        auth_mod,
+        "resolve_antigravity_runtime_credentials",
+        lambda force_refresh=False: {
+            "provider": "google-antigravity",
+            "api_key": "test-token",
+            "base_url": "cloudcode-pa://antigravity",
+            "project_id": "test-project",
+        },
+    )
+    monkeypatch.setattr(auth_mod, "_prompt_model_selection", lambda models, current_model="": "gemini-3.1-pro-high")
+    save_model = Mock()
+    update_provider = Mock()
+    monkeypatch.setattr(auth_mod, "_save_model_choice", save_model)
+    monkeypatch.setattr(auth_mod, "_update_config_for_provider", update_provider)
+    return save_model, update_provider
+
+
+def test_google_antigravity_model_flow_reuses_existing_login(monkeypatch):
+    from agent import google_antigravity_oauth
+    from hermes_cli.main import _model_flow_google_antigravity
+
+    save_model, update_provider = _patch_antigravity_flow(monkeypatch, logged_in=True)
+    start_oauth = Mock()
+    monkeypatch.setattr(google_antigravity_oauth, "start_oauth_flow", start_oauth)
+    monkeypatch.setattr("builtins.input", _InputSeq(["y", "1"]))
+    monkeypatch.setattr("builtins.print", lambda *a, **k: None)
+
+    _model_flow_google_antigravity({}, current_model="")
+
+    start_oauth.assert_not_called()
+    save_model.assert_called_once_with("gemini-3.1-pro-high")
+    update_provider.assert_called_once()
+
+
+def test_google_antigravity_model_flow_can_force_new_login(monkeypatch):
+    from agent import google_antigravity_oauth
+    from hermes_cli.main import _model_flow_google_antigravity
+
+    save_model, update_provider = _patch_antigravity_flow(monkeypatch, logged_in=True)
+    start_oauth = Mock()
+    monkeypatch.setattr(google_antigravity_oauth, "resolve_project_id_from_env", lambda: "env-project")
+    monkeypatch.setattr(google_antigravity_oauth, "start_oauth_flow", start_oauth)
+    monkeypatch.setattr("builtins.input", _InputSeq(["y", "2"]))
+    monkeypatch.setattr("builtins.print", lambda *a, **k: None)
+
+    _model_flow_google_antigravity({}, current_model="")
+
+    start_oauth.assert_called_once_with(force_relogin=True, project_id="env-project")
+    save_model.assert_called_once_with("gemini-3.1-pro-high")
+    update_provider.assert_called_once()
+
+
+def test_google_antigravity_model_flow_logs_in_when_missing_credentials(monkeypatch):
+    from agent import google_antigravity_oauth
+    from hermes_cli.main import _model_flow_google_antigravity
+
+    _patch_antigravity_flow(monkeypatch, logged_in=False)
